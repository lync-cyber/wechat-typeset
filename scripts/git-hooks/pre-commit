#!/usr/bin/env bash
#
# Pre-commit guard：
#   1. 注释纪律检查 —— 扫描暂存的新增行，拦截 CLAUDE.md 禁止的注释形态
#   2. Showcase drift 检查 —— 仅在主题 / 变体 / showcase 源码暂存时跑 gen:showcase --check
#   3. 派生文档漂移检查 —— vocabulary / 主题 / 变体 改了就跑
#        build:writer-docs --check + build:skill-refs --check
#   4. Bundle 体积检查 —— 仅在暂存了影响 bundle 体积的文件时跑 check:size
#
# 退出码：0 = 通过 / 非零 = 阻止 commit
# 跳过（紧急）：SKIP_COMMENT_CHECK=1 / SKIP_SHOWCASE_CHECK=1 / SKIP_DERIVED_DOCS_CHECK=1 / SKIP_SIZE_CHECK=1
# git commit ...（PR 内必须补修）

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# ── 1. 注释纪律检查 ───────────────────────────────────────────────
HAS_SOURCE=$(echo "$STAGED" | grep -E '\.(ts|tsx|vue|js|mjs)$' || true)
if [ -n "$HAS_SOURCE" ]; then
  node scripts/check-comments.mjs --staged
fi

# ── 2. Showcase drift 检查 ─────────────────────────────────────────
# 主题 voice / 变体渲染 / showcase 生成器逻辑变更都会让 docs/generated/showcase 漂移。
# 这里只在相关源码暂存时跑，避免无关 PR 也付 gen:showcase 启动税（tsx + jsdom）。
HAS_SHOWCASE_RELEVANT=$(echo "$STAGED" | grep -E '^(src/core/themes/|src/core/variants/|src/domain/gallery/|scripts/gen-showcase\.ts$|docs/generated/showcase/)' || true)

if [ -n "$HAS_SHOWCASE_RELEVANT" ] && [ "$SKIP_SHOWCASE_CHECK" != "1" ]; then
  echo "[pre-commit] 暂存包含主题 / 变体 / showcase 源码 → 跑 gen:showcase --check"
  node_modules/.bin/tsx scripts/gen-showcase.ts --check
fi

# ── 3. 派生文档漂移检查 ─────────────────────────────────────────
# vocabulary / 主题 / 变体 / 注册表变更会让 docs/contract/*.md 与 skills/_shared/references/*.md
# 静默漂移；同 showcase 按相关性 gate。本次 PR (#68) 因此 CI 红过两次，加上 gate 即可。
HAS_DERIVED_DOCS_RELEVANT=$(echo "$STAGED" | grep -E '^(src/core/vocabulary/|src/core/themes/|src/core/variants/|scripts/build-(writer-docs|skill-refs)\.ts$|docs/contract/|skills/_shared/references/)' || true)

if [ -n "$HAS_DERIVED_DOCS_RELEVANT" ] && [ "$SKIP_DERIVED_DOCS_CHECK" != "1" ]; then
  echo "[pre-commit] 暂存命中 vocabulary/主题/变体 → 跑 build:writer-docs / skill-refs --check"
  node_modules/.bin/tsx scripts/build-writer-docs.ts --check
  node_modules/.bin/tsx scripts/build-skill-refs.ts --check
fi

# ── 4. Bundle 体积检查 ───────────────────────────────────────────
HAS_SIZE_RELEVANT=$(echo "$STAGED" | grep -E '^(src/|vite\.config\.ts$|\.size-budget\.json$|package\.json$|pnpm-lock\.yaml$)' || true)

if [ -z "$HAS_SIZE_RELEVANT" ]; then
  exit 0
fi

if [ "$SKIP_SIZE_CHECK" = "1" ]; then
  echo "[pre-commit] SKIP_SIZE_CHECK=1，跳过 bundle 预算校验（请在 PR 中尽快补救）"
  exit 0
fi

echo "[pre-commit] 暂存包含影响 bundle 体积的源码（${HAS_SIZE_RELEVANT})"
echo "[pre-commit] 跑 vite build + check:size 防止 CI 红"

# 用 node_modules/.bin 直接调，绕开 pnpm/npm 选择
TSX=node_modules/.bin/tsx
VITE=node_modules/.bin/vite

# dist 缺失 → 必须重建；存在 → 看是否有更新的源码再决定
NEED_REBUILD=1
if [ -d dist/assets ]; then
  NEWER=$(find src vite.config.ts -newer dist/assets -print -quit 2>/dev/null || true)
  if [ -z "$NEWER" ]; then NEED_REBUILD=0; fi
fi

if [ "$NEED_REBUILD" = "1" ]; then
  echo "[pre-commit] dist/ 缺失或过期，先重建产物..."
  "$TSX" scripts/build-samples.ts >/dev/null
  "$TSX" scripts/build-references.ts >/dev/null
  "$TSX" scripts/build-showcase.ts >/dev/null
  "$VITE" build >/dev/null 2>&1 || { echo "[pre-commit] vite build 失败"; exit 1; }
fi

"$TSX" scripts/check-size.ts
