<section class="container-table-row" style="display:table-row"><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:transparent;color:#636870;font-weight:700;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;line-height:1.5;padding:10px 12px;border-bottom:1px solid #d8d8d4">型号</span><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:transparent;color:#636870;font-weight:700;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;line-height:1.5;padding:10px 12px;border-bottom:1px solid #d8d8d4">容量</span><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:transparent;color:#636870;font-weight:700;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;line-height:1.5;padding:10px 12px;border-bottom:1px solid #d8d8d4">价格</span></section>
<section class="container-table-row" style="display:table-row"><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:#f5f5f3;color:#1c1f24;font-weight:400;font-size:13px;letter-spacing:normal;text-transform:none;line-height:1.5;padding:10px 12px">A</span><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:#f5f5f3;color:#1c1f24;font-weight:400;font-size:13px;letter-spacing:normal;text-transform:none;line-height:1.5;padding:10px 12px">256G</span><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:#f5f5f3;color:#1c1f24;font-weight:400;font-size:13px;letter-spacing:normal;text-transform:none;line-height:1.5;padding:10px 12px">¥6999</span></section>
<section class="container-table-row" style="display:table-row"><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:#fdfdfc;color:#1c1f24;font-weight:400;font-size:13px;letter-spacing:normal;text-transform:none;line-height:1.5;padding:10px 12px">B</span><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:#fdfdfc;color:#1c1f24;font-weight:400;font-size:13px;letter-spacing:normal;text-transform:none;line-height:1.5;padding:10px 12px">512G</span><span style="display:table-cell;width:33.33%;vertical-align:middle;background-color:#fdfdfc;color:#1c1f24;font-weight:400;font-size:13px;letter-spacing:normal;text-transform:none;line-height:1.5;padding:10px 12px">¥8999</span></section>
</section>
</section>"
