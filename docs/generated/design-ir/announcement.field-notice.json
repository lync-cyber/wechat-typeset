  "rawHtml": "<div style=\"font-family:'Noto Serif SC',serif;background:#ece4d2;padding:6px 0;\">\n  <div style=\"display:flex;align-items:baseline;gap:10px;border-bottom:1.5px solid #1f2a2a;padding-bottom:6px;margin-bottom:12px;\">\n    <span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;color:#8b4a3a;font-weight:600;\">NOTICE</span>\n    <span style=\"flex:1;height:1px;background:#1f2a2a;margin:0 4px;\"></span>\n    <span style=\"font-family:'Lora',serif;font-style:italic;font-size:12px;color:#5e6f6a;\">N° 027</span>\n  </div>\n  <h3 style=\"font-size:17px;color:#1f2a2a;margin:0 0 8px;font-weight:500;letter-spacing:.02em;\">川西考察队招募</h3>\n  <p style=\"font-size:13.5px;line-height:1.85;color:#1f2a2a;margin:0 0 8px;\">为期 21 日，需具备 3500m 以上海拔的野外经验。报名截止 6 月 8 日。</p>\n  <div style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;color:#5e6f6a;letter-spacing:.16em;\">DEPARTURE: 07.04 · CHENGDU</div>\n</div>"
