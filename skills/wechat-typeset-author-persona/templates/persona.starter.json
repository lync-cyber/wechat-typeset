{
  "$comment": "最小可校验的 PersonaSpec 骨架。LLM 起手 spec 时拷此模板，逐字段填实。所有 PLACEHOLDER 必须替换。",
  "id": "PLACEHOLDER_KEBAB_ID",
  "name": "PLACEHOLDER_CN_NAME",
  "description": "PLACEHOLDER_ONE_LINE_POSITIONING",
  "audience": "PLACEHOLDER_AUDIENCE_LABEL",
  "palette": {
    "primary": "#2558b0",
    "secondary": "#8a8f98",
    "accent": "#2558b0",
    "bg": "#fdfdfc",
    "bgSoft": "#f5f5f3",
    "bgMuted": "#eceae4",
    "text": "#1c1f24",
    "textMuted": "#636870",
    "textInverse": "#fefefe",
    "border": "#d8d8d4",
    "code": "#1c1f24"
  },
  "status": {
    "tip":     { "accent": "#1f8a4c", "soft": "#eef6ef" },
    "info":    { "accent": "#2558b0", "soft": "#eef2f9" },
    "warning": { "accent": "#9a6b1a", "soft": "#f7f0df" },
    "danger":  { "accent": "#b42318", "soft": "#fbecea" }
  },
  "typography": {
    "baseSize": 15,
    "lineHeight": 1.75,
    "h1Size": 22,
    "h2Size": 19,
    "h3Size": 16,
    "letterSpacing": 0.3
  },
  "spacing": {
    "paragraph": 18,
    "section": 28,
    "listItem": 10,
    "containerPadding": 16
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12
  },
  "motifs": {
    "h2Prefix": {
      "viewBox": [0, 0, 20, 20],
      "width": 20,
      "height": 20,
      "inlineStyle": {
        "display": "inline-block",
        "verticalAlign": "middle",
        "marginRight": 6
      },
      "primitives": [
        { "type": "rect", "x": 2, "y": 8, "w": 14, "h": 4, "fill": "#2558b0", "rx": 1 },
        { "type": "circle", "cx": 18, "cy": 10, "r": 2, "fill": "#2558b0" }
      ]
    },
    "dividerWave": {
      "viewBox": [0, 0, 200, 12],
      "primitives": [
        {
          "type": "path",
          "d": "M0 6 Q 25 0 50 6 T 100 6 T 150 6 T 200 6",
          "stroke": "#2558b0",
          "strokeWidth": 1.5,
          "fill": "none",
          "strokeLinecap": "round"
        }
      ]
    },
    "stepBadge": {
      "viewBox": [0, 0, 24, 24],
      "width": 24,
      "height": 24,
      "placeholders": ["N"],
      "primitives": [
        { "type": "circle", "cx": 12, "cy": 12, "r": 11, "fill": "#2558b0" },
        {
          "type": "text",
          "x": 12, "y": 12, "content": "{N}", "fontSize": 14,
          "fill": "#fefefe", "fontWeight": 700,
          "textAnchor": "middle", "dominantBaseline": "central"
        }
      ]
    }
  },
  "variants": {
    "admonition": "accent-bar",
    "quote": "classic",
    "compare": "column-card",
    "steps": "number-circle",
    "divider": "wave",
    "sectionTitle": "bordered",
    "codeBlock": "bare",
    "note": "minimal"
  },
  "signatureContainers": [],
  "meta": {
    "createdAt": "2026-05-13"
  }
}
